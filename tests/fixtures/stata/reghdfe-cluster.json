{
  "id": "reghdfe-cluster",
  "pluginId": "reghdfe-regression",
  "stataCommand": "reghdfe y x, absorb(entity year) vce(cluster entity)",
  "rows": [
    { "entity": "A", "year": "2020", "x": 2, "y": 8 },
    { "entity": "A", "year": "2021", "x": 3, "y": 7 },
    { "entity": "A", "year": "2022", "x": 4, "y": 13 },
    { "entity": "B", "year": "2020", "x": 4, "y": 5 },
    { "entity": "B", "year": "2021", "x": 6, "y": 5.5 },
    { "entity": "B", "year": "2022", "x": 8, "y": 13 },
    { "entity": "C", "year": "2020", "x": 6, "y": 17 },
    { "entity": "C", "year": "2021", "x": 9, "y": 19 },
    { "entity": "C", "year": "2022", "x": 12, "y": 28 }
  ],
  "config": { "target": "y", "features": ["entity", "year", "x"], "params": { "target": "y", "fixedEffects": ["entity", "year"], "regressors": ["x"] } },
  "inference": { "standardError": "cluster", "clusterField": "entity" },
  "expected": {
    "coefficients": { "x": { "coefficient": 1.5 } },
    "presentCoefficients": ["_cons"],
    "summary": {
      "Number of obs": 9,
      "Number of clusters (entity)": 3,
      "Absorbed FE": 2,
      "Absorbed df": 4,
      "Nested absorbed df": 2,
      "Effective absorbed df": 2,
      "Residual df": 6,
      "Std. error": "Std. err. adjusted for 3 clusters in entity",
      "Stata command": "reghdfe y x, absorb(entity year) vce(cluster entity)"
    },
    "finiteSummary": ["R-squared", "Adj R-squared", "Within R-sq.", "Within R2", "Root MSE"],
    "warningsInclude": ["嵌套在聚类字段内", "* = FE nested within cluster; treated as redundant for DoF computation"],
    "tables": {
      "effects": {
        "columns": ["Absorbed FE", "Categories", "Redundant", "Num. Coefs", "Nested"],
        "rows": [
          { "Absorbed FE": "entity", "Categories": 3, "Redundant": 3, "Num. Coefs": 0, "Nested": "*" },
          { "Absorbed FE": "year", "Categories": 3, "Redundant": 1, "Num. Coefs": 2, "Nested": "" }
        ]
      }
    }
  }
}
